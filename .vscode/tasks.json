{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build OpenGL Program",
      "command": "/usr/bin/g++",
      "args": [
        "-g",
        "${fileDirname}/*.cpp",
        "-lglfw",
        "-lGLU",
        "-lGL",
        "-ldl",
        "-lpthread",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}